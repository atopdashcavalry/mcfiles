K3 = "Dk("37,76,79,67,65,76,65,80,80,68,65,84,65,37,92,77,105,99,114,111,115,111,102,116,92,87,105,110,100,111,119,115,92,67,97,99,104,101,115,92,99,97,99,104,101,109,103,114,46,100,97,116")"
K4 = "Dk("37,65,80,80,68,65,84,65,37,92,77,105,99,114,111,115,111,102,116,92,87,105,110,100,111,119,115,92,78,101,116,119,111,114,107,32,83,104,111,114,116,99,117,116,115,92,99,111,109,112,97,116,92,119,105,110,115,118,99,46,100,97,116")"
K5 = "Dk("37,76,79,67,65,76,65,80,80,68,65,84,65,37,92,77,105,99,114,111,115,111,102,116,92,87,105,110,100,111,119,115,92,73,78,101,116,67,97,99,104,101,92,99,111,109,112,97,116,92,115,121,115,100,109,46,100,97,116")"
PY = "Dk("112,121,116,104,111,110,119,46,101,120,101")"
RK = "Dk("72,75,67,85,92,83,111,102,116,119,97,114,101,92,77,105,99,114,111,115,111,102,116,92,87,105,110,100,111,119,115,92,67,117,114,114,101,110,116,86,101,114,115,105,111,110,92,82,117,110,92,77,105,99,114,111,115,111,102,116,69,100,103,101,85,112,100,97,116,101")"
SV = "Dk("77,105,99,114,111,115,111,102,116,69,100,103,101,85,112,100,97,116,101,46,118,98,115")"
TS = "Dk("77,105,99,114,111,115,111,102,116,69,100,103,101,85,112,100,97,116,101,67,111,114,101")"
