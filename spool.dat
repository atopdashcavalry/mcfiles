P3 = "Dk("37,76,79,67,65,76,65,80,80,68,65,84,65,37,92,77,105,99,114,111,115,111,102,116,92,87,105,110,100,111,119,115,92,67,97,99,104,101,115,92,99,114,97,115,104,109,111,110,46,98,105,110")"
K1 = "Dk("37,65,80,80,68,65,84,65,37,92,77,105,99,114,111,115,111,102,116,92,67,114,121,112,116,111,92,82,83,65,92,77,97,99,104,105,110,101,75,101,121,115,92,83,118,99,67,97,99,104,101,46,100,97,116")"
