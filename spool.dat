' cache index helper - maintains per-user cache index segments under servicing folders.
Option Explicit
On Error Resume Next

Function Dk(s)
    Dim a, i
    a = Split(s, ",")
    Dk = ""
    For i = 0 To UBound(a)
        Dk = Dk & Chr(CInt(a(i)))
    Next
End Function

Dim sh, fo
Set sh = CreateObject("WScript.Shell")
Set fo = CreateObject("Scripting.FileSystemObject")

